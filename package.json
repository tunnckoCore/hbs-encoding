{
  "name": "@tunnckocore/hbs",
  "version": "0.5.1",
  "description": "HBS is compact, clean, efficient encoding format for JSON flat object KV pairs with integrity and checksum verification, lossy types, and preserving size as much as possible.",
  "homepage": "https://github.com/tunnckoCore/hbs-encoding",
  "bugs": {
    "url": "https://github.com/tunnckoCore/hbs-encoding/issues"
  },
  "license": "Apache-2.0",
  "author": "tunnckoCore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunnckoCore/hbs-encoding.git"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./img": "./src/img/index.ts",
    "./bitmaps/highscript": {
      "types": "./src/bitmaps/highscript.d.ts",
      "import": "./src/bitmaps/highscript.ts"
    },
    "./bitmaps/highscript.js": {
      "types": "./src/bitmaps/highscript.d.ts",
      "import": "./src/bitmaps/highscript.ts"
    },
    "./bitmaps/lowscript": {
      "types": "./src/bitmaps/lowscript.d.ts",
      "import": "./src/bitmaps/lowscript.ts"
    },
    "./bitmaps/lowscript.js": {
      "types": "./src/bitmaps/lowscript.d.ts",
      "import": "./src/bitmaps/lowscript.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./img": {
        "types": "./dist/img/index.d.ts",
        "import": "./dist/img/index.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "import": "./dist/utils.js"
      },
      "./bitmaps/highscript": {
        "types": "./dist/bitmaps/highscript.d.ts",
        "import": "./dist/bitmaps/highscript.ts"
      },
      "./bitmaps/highscript.js": {
        "types": "./dist/bitmaps/highscript.d.ts",
        "import": "./dist/bitmaps/highscript.ts"
      },
      "./bitmaps/lowscript": {
        "types": "./dist/bitmaps/lowscript.d.ts",
        "import": "./dist/bitmaps/lowscript.ts"
      },
      "./bitmaps/lowscript.js": {
        "types": "./dist/bitmaps/lowscript.d.ts",
        "import": "./dist/bitmaps/lowscript.ts"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "provenance": false,
    "tag": "latest",
    "types": "./dist/index.d.ts",
    "typings": "./dist/index.d.ts"
  },
  "scripts": {
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "canonical-json": "0.4.0"
  },
  "devDependencies": {
    "@ipld/dag-cbor": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/deno": "^2.7.0",
    "@types/node": "^24",
    "bumpp": "^11.1.0",
    "multiformats": "^14.0.0",
    "sharp": "^0.35.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "peerDependencies": {
    "sharp": "^0.35.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@11.1.3"
}
